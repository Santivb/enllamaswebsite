# -----------------------------------------------------------------------
# En Llamas 87 — environment variables
# -----------------------------------------------------------------------
# Copy this file to .env.local and fill in real values as each integration
# becomes available. Nothing in src/ ever hardcodes a secret — every key
# below is read via process.env at the point of use (see src/lib/services/).
# .env.local is gitignored by default in Next.js — never commit real keys.

# --- Email (contact / catering / bulk-order / online-order pipeline) ---
# src/lib/services/email.ts tries Resend first (if RESEND_API_KEY is set),
# then falls back to sending straight through Gmail's SMTP servers using the
# two variables below. Leave both unset and the API route responds with a
# clear "email is not configured yet" error instead of failing silently.
#
# To use Gmail (no third-party signup needed):
#   1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
#   2. Create an App Password: myaccount.google.com/apppasswords
#   3. Paste the Gmail address and the 16-character app password below.
GMAIL_USER=
GMAIL_APP_PASSWORD=

RESEND_API_KEY=

# Destination inbox for the contact form. Falls back to
# businessConfig.email (src/config/business.ts) if unset.
CONTACT_FORM_RECIPIENT_EMAIL=

# --- Payments (Stripe) ---
# "Pay Online Now" on the Order page redirects to a Stripe-hosted Checkout
# page, so only the secret key below is required — no card data ever
# touches this server. Get it from the Stripe Dashboard: Developers -> API
# keys. Use the "Secret key" (starts with sk_test_... while testing, or
# sk_live_... once ready for real charges).
STRIPE_SECRET_KEY=
# Not currently used (no client-side Stripe.js in this flow) — reserved for
# a future embedded/Elements-based checkout if that's ever preferred.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# REQUIRED. This is what tells the kitchen an order came in — Stripe calls
# /api/stripe/webhook directly, so an order still lands even if the customer
# closes the tab the second they pay. Without it that endpoint returns 503 and
# paid orders reach nobody.
#   1. Stripe Dashboard -> Developers -> Webhooks -> "Add endpoint"
#   2. Endpoint URL: https://<your-domain>/api/stripe/webhook
#   3. Events to send: checkout.session.completed
#                      checkout.session.async_payment_succeeded
#   4. Copy the endpoint's "Signing secret" (starts with whsec_...) below.
# To test locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints a whsec_... to use here.
STRIPE_WEBHOOK_SECRET=

# --- Receipt printing (PrintNode) ---
# Prints the kitchen ticket on the restaurant's Epson TM-U220B as each paid
# order arrives. src/lib/services/print.ts submits the same monospace ticket
# the email carries to PrintNode's API as a raw job.
#
# Printing is entirely optional at runtime: leave both blank and orders still
# email exactly as before, with a single info-level log line noting the skip.
#
# Setup (the owner does this — it needs their own account and the printer
# physically connected):
#   1. Create an account at printnode.com. Free covers 50 prints/month;
#      the $9/mo Essential plan covers 5,000.
#   2. Install the PrintNode Client on the always-on computer the TM-U220B is
#      plugged into (Windows, macOS, Linux and Raspberry Pi are all supported)
#      and sign in. The printer appears automatically once the OS can see it.
#   3. API key: PrintNode dashboard -> Account -> API Keys -> create one.
#   4. Printer ID: PrintNode dashboard -> Printers. It's the numeric id next to
#      the printer, NOT its name. Must be a plain positive integer here.
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_ID=

# --- POS (future — pick whichever the restaurant adopts) ---
TOAST_API_KEY=
SQUARE_ACCESS_TOKEN=
CLOVER_API_KEY=

# --- Delivery marketplaces (future) ---
# Most integrations happen via each platform's merchant portal rather than
# API keys embedded here — see src/lib/services/delivery.ts for notes.
DOORDASH_DEVELOPER_KEY=
UBEREATS_API_KEY=

# --- Reservations (future — pick whichever the restaurant adopts) ---
OPENTABLE_API_KEY=
SEVENROOMS_API_KEY=
TOAST_RESERVATIONS_API_KEY=

# --- Reviews / social (future) ---
GOOGLE_PLACES_API_KEY=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
