# -----------------------------------------------------------------------
# En Llamas 87 — environment variables
# -----------------------------------------------------------------------
# Copy this file to .env.local and fill in real values as each integration
# becomes available. Nothing in src/ ever hardcodes a secret — every key
# below is read via process.env at the point of use (see src/lib/services/).
# .env.local is gitignored by default in Next.js — never commit real keys.

# --- Email (contact / catering / reservation / special-order pipeline) ---
# Pick ONE provider. src/lib/services/email.ts checks them in this order:
# Resend -> SendGrid -> raw SMTP. Leave unset and the API route responds
# with a clear "email is not configured yet" error instead of failing silently.
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Destination inbox for the contact form. Falls back to
# businessConfig.email (src/config/business.ts) if unset.
CONTACT_FORM_RECIPIENT_EMAIL=

# --- Payments (Stripe) ---
# Server-only secret key — never prefix this one with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Client-safe publishable key, used by Stripe.js in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set once a Stripe webhook endpoint exists, to verify webhook signatures.
STRIPE_WEBHOOK_SECRET=

# --- POS (future — pick whichever the restaurant adopts) ---
TOAST_API_KEY=
SQUARE_ACCESS_TOKEN=
CLOVER_API_KEY=

# --- Delivery marketplaces (future) ---
# Most integrations happen via each platform's merchant portal rather than
# API keys embedded here — see src/lib/services/delivery.ts for notes.
DOORDASH_DEVELOPER_KEY=
UBEREATS_API_KEY=

# --- Reservations (future — pick whichever the restaurant adopts) ---
OPENTABLE_API_KEY=
SEVENROOMS_API_KEY=
TOAST_RESERVATIONS_API_KEY=

# --- Reviews / social (future) ---
GOOGLE_PLACES_API_KEY=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
